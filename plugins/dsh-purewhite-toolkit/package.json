{
  "name": "dsh-purewhite-toolkit",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "纯白莱茵自用 DSH 工具集：screenshot 工具、内置技能 sync-config、只读模式与智能体模式两个 Agent 预设及其守卫。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./readonly-guard": "./readonly-guard.js",
    "./agent-mode-guard": "./agent-mode-guard.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "readonly-guard.js",
    "agent-mode-guard.js",
    "client.js",
    "cordis.patch.yml",
    "profile-snippet.yml",
    "skills",
    "native",
    "build/dshtool-capture.exe",
    "scripts",
    "test",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-helper.mjs",
    "test": "node scripts/build-helper.mjs && node test/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "screenshot",
    "windows",
    "macos"
  ],
  "license": "MIT"
}
